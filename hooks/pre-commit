#!/bin/bash
# Code Review Pre-Commit Hook
# Usage: Copy this file to .git/hooks/pre-commit

set -e

echo "🔍 Running code review on staged changes..."

# Get the diff of staged files
diff_content=$(git diff --cached --diff-filter=ACMR --staged -- "*.py" "*.js" "*.ts" "*.go" "*.rs" "*.java")

if [ -z "$diff_content" ]; then
    echo "No staged code changes to review."
    exit 0
fi

# Run code review using stdin
result=$(echo "$diff_content" | python -m code_review.main diff 2>&1) || true

echo "$result"

# Check for critical issues
critical_count=$(echo "$result" | grep -oP "Critical:\s*\K[0-9]+" || echo "0")

if [ "$critical_count" -gt 0 ]; then
    echo ""
    echo "❌ Review found $critical_count critical issue(s). Please fix them before committing."
    exit 1
fi

echo ""
echo "✅ Code review passed. Proceeding with commit."

exit 0
